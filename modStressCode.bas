Public Function StressSSE32Hex() As String
    Dim Code As String
    ' BITS 32
    ' ; SSE32: four independent packed-single accumulators; 128 FLOPs/iteration.
    ' ; x86 stdcall: [ebp+12]=scratch, [ebp+16]=iterations; RET 16.
    ' ; Same alternating finite recurrence and 256-iteration resets as x64 kernels.
    ' ; Preserve nonvolatile GPRs; XMM registers are volatile in the x86 ABI.
    Code = Code & " 55" ' push ebp
    Code = Code & " 89 E5" ' mov ebp, esp
    Code = Code & " 53" ' push ebx
    Code = Code & " 56" ' push esi
    Code = Code & " 57" ' push edi
    Code = Code & " 8B 75 10" ' mov esi, [ebp+16]
    Code = Code & " 31 C0" ' xor eax, eax
    Code = Code & " 85 F6" ' test esi, esi
    Code = Code & " 0F 84 AD 00 00 00" ' jz .empty
    Code = Code & " 8B 5D 0C" ' mov ebx, [ebp+12]
    Code = Code & " E8 00 00 00 00" ' call .address
    ' .address:
    Code = Code & " 59" ' pop ecx
    Code = Code & " 81 C1 B5 00 00 00" ' add ecx, data-.address
    Code = Code & " 0F 10 61 40" ' movups xmm4, [ecx+factor_down-data]
    Code = Code & " 0F 10 69 50" ' movups xmm5, [ecx+bias_up-data]
    Code = Code & " 0F 10 71 60" ' movups xmm6, [ecx+factor_up-data]
    Code = Code & " 0F 10 79 70" ' movups xmm7, [ecx+bias_down-data]
    ' .reset:
    Code = Code & " 0F 10 01" ' movups xmm0, [ecx+seed0-data]
    Code = Code & " 0F 10 49 10" ' movups xmm1, [ecx+seed1-data]
    Code = Code & " 0F 10 51 20" ' movups xmm2, [ecx+seed2-data]
    Code = Code & " 0F 10 59 30" ' movups xmm3, [ecx+seed3-data]
    Code = Code & " BF 00 01 00 00" ' mov edi, 256
    ' .loop:
    Code = Code & " 0F 59 C4" ' mulps xmm0, xmm4
    Code = Code & " 0F 59 CC" ' mulps xmm1, xmm4
    Code = Code & " 0F 59 D4" ' mulps xmm2, xmm4
    Code = Code & " 0F 59 DC" ' mulps xmm3, xmm4
    Code = Code & " 0F 58 C5" ' addps xmm0, xmm5
    Code = Code & " 0F 58 CD" ' addps xmm1, xmm5
    Code = Code & " 0F 58 D5" ' addps xmm2, xmm5
    Code = Code & " 0F 58 DD" ' addps xmm3, xmm5
    Code = Code & " 0F 59 C6" ' mulps xmm0, xmm6
    Code = Code & " 0F 59 CE" ' mulps xmm1, xmm6
    Code = Code & " 0F 59 D6" ' mulps xmm2, xmm6
    Code = Code & " 0F 59 DE" ' mulps xmm3, xmm6
    Code = Code & " 0F 58 C7" ' addps xmm0, xmm7
    Code = Code & " 0F 58 CF" ' addps xmm1, xmm7
    Code = Code & " 0F 58 D7" ' addps xmm2, xmm7
    Code = Code & " 0F 58 DF" ' addps xmm3, xmm7
    Code = Code & " 0F 59 C4" ' mulps xmm0, xmm4
    Code = Code & " 0F 59 CC" ' mulps xmm1, xmm4
    Code = Code & " 0F 59 D4" ' mulps xmm2, xmm4
    Code = Code & " 0F 59 DC" ' mulps xmm3, xmm4
    Code = Code & " 0F 58 C5" ' addps xmm0, xmm5
    Code = Code & " 0F 58 CD" ' addps xmm1, xmm5
    Code = Code & " 0F 58 D5" ' addps xmm2, xmm5
    Code = Code & " 0F 58 DD" ' addps xmm3, xmm5
    Code = Code & " 0F 59 C6" ' mulps xmm0, xmm6
    Code = Code & " 0F 59 CE" ' mulps xmm1, xmm6
    Code = Code & " 0F 59 D6" ' mulps xmm2, xmm6
    Code = Code & " 0F 59 DE" ' mulps xmm3, xmm6
    Code = Code & " 0F 58 C7" ' addps xmm0, xmm7
    Code = Code & " 0F 58 CF" ' addps xmm1, xmm7
    Code = Code & " 0F 58 D7" ' addps xmm2, xmm7
    Code = Code & " 0F 58 DF" ' addps xmm3, xmm7
    Code = Code & " 4E" ' dec esi
    Code = Code & " 74 05" ' jz .finished
    Code = Code & " 4F" ' dec edi
    Code = Code & " 75 9A" ' jnz .loop
    Code = Code & " EB 84" ' jmp .reset
    ' .finished:
    Code = Code & " 0F 11 03" ' movups [ebx+0], xmm0
    Code = Code & " 0F 11 4B 10" ' movups [ebx+16], xmm1
    Code = Code & " 0F 11 53 20" ' movups [ebx+32], xmm2
    Code = Code & " 0F 11 5B 30" ' movups [ebx+48], xmm3
    Code = Code & " 8B 45 10" ' mov eax, [ebp+16]
    ' .empty:
    Code = Code & " 5F" ' pop edi
    Code = Code & " 5E" ' pop esi
    Code = Code & " 5B" ' pop ebx
    Code = Code & " 5D" ' pop ebp
    Code = Code & " C2 10 00" ' ret 16
    Code = Code & " 00 00 00 00 00 00 00 00 00" ' align 16, db 0
    ' data:
    Code = Code & " 00 00 00 3E 00 00 10 3E 00 00 20 3E 00 00 30 3E" ' seed0: dd 0x3e000000, 0x3e100000, 0x3e200000, 0x3e300000
    Code = Code & " 00 00 80 3E 00 00 88 3E 00 00 90 3E 00 00 98 3E" ' seed1: dd 0x3e800000, 0x3e880000, 0x3e900000, 0x3e980000
    Code = Code & " 00 00 C0 3E 00 00 C8 3E 00 00 D0 3E 00 00 D8 3E" ' seed2: dd 0x3ec00000, 0x3ec80000, 0x3ed00000, 0x3ed80000
    Code = Code & " 00 00 00 3F 00 00 04 3F 00 00 08 3F 00 00 0C 3F" ' seed3: dd 0x3f000000, 0x3f040000, 0x3f080000, 0x3f0c0000
    Code = Code & " FF FF 7F 3F FF FF 7F 3F FF FF 7F 3F FF FF 7F 3F" ' factor_down: dd 0x3f7fffff, 0x3f7fffff, 0x3f7fffff, 0x3f7fffff
    Code = Code & " 00 00 80 35 00 00 80 35 00 00 80 35 00 00 80 35" ' bias_up: dd 0x35800000, 0x35800000, 0x35800000, 0x35800000
    Code = Code & " 01 00 80 3F 01 00 80 3F 01 00 80 3F 01 00 80 3F" ' factor_up: dd 0x3f800001, 0x3f800001, 0x3f800001, 0x3f800001
    Code = Code & " 00 00 00 B5 00 00 00 B5 00 00 00 B5 00 00 00 B5" ' bias_down: dd 0xb5000000, 0xb5000000, 0xb5000000, 0xb5000000
    StressSSE32Hex = Mid$(Code, 2)
End Function

Public Function StressLegacy32Hex() As String
