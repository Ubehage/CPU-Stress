    Code = Code & " 41 0F 59 FA" ' mulps xmm7, xmm10
    Code = Code & " 41 0F 58 C3" ' addps xmm0, xmm11
    Code = Code & " 41 0F 58 CB" ' addps xmm1, xmm11
    Code = Code & " 41 0F 58 D3" ' addps xmm2, xmm11
    Code = Code & " 41 0F 58 DB" ' addps xmm3, xmm11
    Code = Code & " 41 0F 58 E3" ' addps xmm4, xmm11
    Code = Code & " 41 0F 58 EB" ' addps xmm5, xmm11
    Code = Code & " 41 0F 58 F3" ' addps xmm6, xmm11
    Code = Code & " 41 0F 58 FB" ' addps xmm7, xmm11
    ' ; Update 3: slightly below one, positive bias.
    Code = Code & " 41 0F 59 C0" ' mulps xmm0, xmm8
    Code = Code & " 41 0F 59 C8" ' mulps xmm1, xmm8
    Code = Code & " 41 0F 59 D0" ' mulps xmm2, xmm8
    Code = Code & " 41 0F 59 D8" ' mulps xmm3, xmm8
    Code = Code & " 41 0F 59 E0" ' mulps xmm4, xmm8
    Code = Code & " 41 0F 59 E8" ' mulps xmm5, xmm8
    Code = Code & " 41 0F 59 F0" ' mulps xmm6, xmm8
    Code = Code & " 41 0F 59 F8" ' mulps xmm7, xmm8
    Code = Code & " 41 0F 58 C1" ' addps xmm0, xmm9
    Code = Code & " 41 0F 58 C9" ' addps xmm1, xmm9
    Code = Code & " 41 0F 58 D1" ' addps xmm2, xmm9
    Code = Code & " 41 0F 58 D9" ' addps xmm3, xmm9
    Code = Code & " 41 0F 58 E1" ' addps xmm4, xmm9
    Code = Code & " 41 0F 58 E9" ' addps xmm5, xmm9
    Code = Code & " 41 0F 58 F1" ' addps xmm6, xmm9
    Code = Code & " 41 0F 58 F9" ' addps xmm7, xmm9
    ' ; Update 4: slightly above one, negative bias.
    Code = Code & " 41 0F 59 C2" ' mulps xmm0, xmm10
    Code = Code & " 41 0F 59 CA" ' mulps xmm1, xmm10
    Code = Code & " 41 0F 59 D2" ' mulps xmm2, xmm10
    Code = Code & " 41 0F 59 DA" ' mulps xmm3, xmm10
    Code = Code & " 41 0F 59 E2" ' mulps xmm4, xmm10
    Code = Code & " 41 0F 59 EA" ' mulps xmm5, xmm10
    Code = Code & " 41 0F 59 F2" ' mulps xmm6, xmm10
    Code = Code & " 41 0F 59 FA" ' mulps xmm7, xmm10
    Code = Code & " 41 0F 58 C3" ' addps xmm0, xmm11
    Code = Code & " 41 0F 58 CB" ' addps xmm1, xmm11
    Code = Code & " 41 0F 58 D3" ' addps xmm2, xmm11
    Code = Code & " 41 0F 58 DB" ' addps xmm3, xmm11
    Code = Code & " 41 0F 58 E3" ' addps xmm4, xmm11
    Code = Code & " 41 0F 58 EB" ' addps xmm5, xmm11
    Code = Code & " 41 0F 58 F3" ' addps xmm6, xmm11
    Code = Code & " 41 0F 58 FB" ' addps xmm7, xmm11
    Code = Code & " 49 FF CA" ' dec r10
    Code = Code & " 74 0E" ' jz .finished
    Code = Code & " 41 FF CB" ' dec r11d
    Code = Code & " 0F 85 F2 FE FF FF" ' jnz .loop
    Code = Code & " E9 AF FE FF FF" ' jmp .reset
    ' .finished:
    Code = Code & " 0F 11 02" ' movups [rdx+0], xmm0
    Code = Code & " 0F 11 4A 10" ' movups [rdx+16], xmm1
    Code = Code & " 0F 11 52 20" ' movups [rdx+32], xmm2
    Code = Code & " 0F 11 5A 30" ' movups [rdx+48], xmm3
    Code = Code & " 0F 11 62 40" ' movups [rdx+64], xmm4
    Code = Code & " 0F 11 6A 50" ' movups [rdx+80], xmm5
    Code = Code & " 0F 11 72 60" ' movups [rdx+96], xmm6
    Code = Code & " 0F 11 7A 70" ' movups [rdx+112], xmm7
    Code = Code & " 66 0F 6F 34 24" ' movdqa xmm6, [rsp+0]
    Code = Code & " 66 0F 6F 7C 24 10" ' movdqa xmm7, [rsp+16]
    Code = Code & " 66 44 0F 6F 44 24 20" ' movdqa xmm8, [rsp+32]
    Code = Code & " 66 44 0F 6F 4C 24 30" ' movdqa xmm9, [rsp+48]
    Code = Code & " 66 44 0F 6F 54 24 40" ' movdqa xmm10, [rsp+64]
    Code = Code & " 66 44 0F 6F 5C 24 50" ' movdqa xmm11, [rsp+80]
    Code = Code & " 48 83 C4 68" ' add rsp, 104
    Code = Code & " 4C 89 C0" ' mov rax, r8
    ' .empty:
    Code = Code & " C3" ' ret
    Code = Code & " 00 00 00 00 00 00 00 00" ' align 16, db 0
    ' data:
    Code = Code & " 00 00 00 3E 00 00 10 3E 00 00 20 3E 00 00 30 3E" ' seed0: dd 0x3e000000, 0x3e100000, 0x3e200000, 0x3e300000
    Code = Code & " 00 00 80 3E 00 00 88 3E 00 00 90 3E 00 00 98 3E" ' seed1: dd 0x3e800000, 0x3e880000, 0x3e900000, 0x3e980000
    Code = Code & " 00 00 C0 3E 00 00 C8 3E 00 00 D0 3E 00 00 D8 3E" ' seed2: dd 0x3ec00000, 0x3ec80000, 0x3ed00000, 0x3ed80000
    Code = Code & " 00 00 00 3F 00 00 04 3F 00 00 08 3F 00 00 0C 3F" ' seed3: dd 0x3f000000, 0x3f040000, 0x3f080000, 0x3f0c0000
    Code = Code & " 00 00 20 3F 00 00 24 3F 00 00 28 3F 00 00 2C 3F" ' seed4: dd 0x3f200000, 0x3f240000, 0x3f280000, 0x3f2c0000
    Code = Code & " 00 00 40 3F 00 00 44 3F 00 00 48 3F 00 00 4C 3F" ' seed5: dd 0x3f400000, 0x3f440000, 0x3f480000, 0x3f4c0000
    Code = Code & " 00 00 60 3F 00 00 64 3F 00 00 68 3F 00 00 6C 3F" ' seed6: dd 0x3f600000, 0x3f640000, 0x3f680000, 0x3f6c0000
    Code = Code & " 00 00 80 3F 00 00 82 3F 00 00 84 3F 00 00 86 3F" ' seed7: dd 0x3f800000, 0x3f820000, 0x3f840000, 0x3f860000
    Code = Code & " FF FF 7F 3F FF FF 7F 3F FF FF 7F 3F FF FF 7F 3F" ' factor_down: dd 0x3f7fffff, 0x3f7fffff, 0x3f7fffff, 0x3f7fffff
    Code = Code & " 00 00 80 35 00 00 80 35 00 00 80 35 00 00 80 35" ' bias_up: dd 0x35800000, 0x35800000, 0x35800000, 0x35800000
    Code = Code & " 01 00 80 3F 01 00 80 3F 01 00 80 3F 01 00 80 3F" ' factor_up: dd 0x3f800001, 0x3f800001, 0x3f800001, 0x3f800001
    Code = Code & " 00 00 00 B5 00 00 00 B5 00 00 00 B5 00 00 00 B5" ' bias_down: dd 0xb5000000, 0xb5000000, 0xb5000000, 0xb5000000
