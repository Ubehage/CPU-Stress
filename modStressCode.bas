    Code = Code & " 01 00 80 3F 01 00 80 3F" ' continued bytes: factor_up: dd 0x3f800001, 0x3f800001, 0x3f800001, 0x3f800001, 0x3f800001, 0x3f800001, 0x3f800001, 0x3f800001
    Code = Code & " 00 00 00 B5 00 00 00 B5 00 00 00 B5 00 00 00 B5 00 00 00 B5 00 00 00 B5" ' bias_down: dd 0xb5000000, 0xb5000000, 0xb5000000, 0xb5000000, 0xb5000000, 0xb5000000, 0xb5000000, 0xb5000000
    Code = Code & " 00 00 00 B5 00 00 00 B5" ' continued bytes: bias_down: dd 0xb5000000, 0xb5000000, 0xb5000000, 0xb5000000, 0xb5000000, 0xb5000000, 0xb5000000, 0xb5000000
    StressAVX64Hex = Mid$(Code, 2)
End Function

Public Function StressSSE64Hex() As String
    Dim Code As String
    ' BITS 64
    ' ; SSE64: 8 independent 128-bit accumulators; four updates per iteration.
    ' ; 256 floating-point operations per iteration. No Windows API calls.
    ' ; Windows x64 ABI: RDX=scratch, R8=iterations, R9=usable bytes.
    ' ; Every 256 iterations restart different finite seeds, avoiding convergence.
    ' ; Updates alternate x*(1-2^-24)+2^-20 and x*(1+2^-23)-2^-21.
    ' ; Store every accumulator; return the requested iteration count.
    Code = Code & " 4D 89 C2" ' mov r10, r8
    Code = Code & " 31 C0" ' xor eax, eax
    Code = Code & " 4D 85 D2" ' test r10, r10
    Code = Code & " 0F 84 E9 01 00 00" ' jz .empty
    Code = Code & " 48 83 EC 68" ' sub rsp, 104
    Code = Code & " 66 0F 7F 34 24" ' movdqa [rsp+0], xmm6
    Code = Code & " 66 0F 7F 7C 24 10" ' movdqa [rsp+16], xmm7
    Code = Code & " 66 44 0F 7F 44 24 20" ' movdqa [rsp+32], xmm8
    Code = Code & " 66 44 0F 7F 4C 24 30" ' movdqa [rsp+48], xmm9
    Code = Code & " 66 44 0F 7F 54 24 40" ' movdqa [rsp+64], xmm10
    Code = Code & " 66 44 0F 7F 5C 24 50" ' movdqa [rsp+80], xmm11
    Code = Code & " 44 0F 10 05 3F 02 00 00" ' movups xmm8, [rel factor_down]
    Code = Code & " 44 0F 10 0D 47 02 00 00" ' movups xmm9, [rel bias_up]
    Code = Code & " 44 0F 10 15 4F 02 00 00" ' movups xmm10, [rel factor_up]
    Code = Code & " 44 0F 10 1D 57 02 00 00" ' movups xmm11, [rel bias_down]
    ' .reset:
    Code = Code & " 0F 10 05 A0 01 00 00" ' movups xmm0, [rel seed0]
    Code = Code & " 0F 10 0D A9 01 00 00" ' movups xmm1, [rel seed1]
    Code = Code & " 0F 10 15 B2 01 00 00" ' movups xmm2, [rel seed2]
    Code = Code & " 0F 10 1D BB 01 00 00" ' movups xmm3, [rel seed3]
    Code = Code & " 0F 10 25 C4 01 00 00" ' movups xmm4, [rel seed4]
    Code = Code & " 0F 10 2D CD 01 00 00" ' movups xmm5, [rel seed5]
    Code = Code & " 0F 10 35 D6 01 00 00" ' movups xmm6, [rel seed6]
    Code = Code & " 0F 10 3D DF 01 00 00" ' movups xmm7, [rel seed7]
    Code = Code & " 41 BB 00 01 00 00" ' mov r11d, 256
    ' .loop:
    ' ; Update 1: slightly below one, positive bias.
    Code = Code & " 41 0F 59 C0" ' mulps xmm0, xmm8
    Code = Code & " 41 0F 59 C8" ' mulps xmm1, xmm8
    Code = Code & " 41 0F 59 D0" ' mulps xmm2, xmm8
    Code = Code & " 41 0F 59 D8" ' mulps xmm3, xmm8
    Code = Code & " 41 0F 59 E0" ' mulps xmm4, xmm8
    Code = Code & " 41 0F 59 E8" ' mulps xmm5, xmm8
    Code = Code & " 41 0F 59 F0" ' mulps xmm6, xmm8
    Code = Code & " 41 0F 59 F8" ' mulps xmm7, xmm8
    Code = Code & " 41 0F 58 C1" ' addps xmm0, xmm9
    Code = Code & " 41 0F 58 C9" ' addps xmm1, xmm9
    Code = Code & " 41 0F 58 D1" ' addps xmm2, xmm9
    Code = Code & " 41 0F 58 D9" ' addps xmm3, xmm9
    Code = Code & " 41 0F 58 E1" ' addps xmm4, xmm9
    Code = Code & " 41 0F 58 E9" ' addps xmm5, xmm9
    Code = Code & " 41 0F 58 F1" ' addps xmm6, xmm9
    Code = Code & " 41 0F 58 F9" ' addps xmm7, xmm9
    ' ; Update 2: slightly above one, negative bias.
    Code = Code & " 41 0F 59 C2" ' mulps xmm0, xmm10
    Code = Code & " 41 0F 59 CA" ' mulps xmm1, xmm10
    Code = Code & " 41 0F 59 D2" ' mulps xmm2, xmm10
    Code = Code & " 41 0F 59 DA" ' mulps xmm3, xmm10
    Code = Code & " 41 0F 59 E2" ' mulps xmm4, xmm10
